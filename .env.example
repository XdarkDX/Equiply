# Kopieren nach .env und Werte anpassen. Die .env wird NICHT ins Git eingecheckt.
# Bei einer Server-Installation über deploy/install.sh wird stattdessen
# /etc/equiply/equiply.env automatisch erzeugt.

PORT=3000
# 127.0.0.1 = nur lokal (hinter Caddy/nginx), 0.0.0.0 = direkt von außen erreichbar
HOST=0.0.0.0

# Speicherorte (Ordner werden automatisch angelegt)
DB_PATH=./data/equiply.db
UPLOAD_DIR=./data/uploads

# Geheimer Schlüssel für Logins. Erzeugen z. B. mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Wie viele Tage man ohne Nutzung angemeldet bleibt
SESSION_DAYS=14

# true = weitere Vereine dürfen sich auf diesem Server selbst registrieren.
# Standard: Nur die Ersteinrichtung ist möglich, danach legt der Admin Mitglieder an.
ALLOW_REGISTRATION=false
