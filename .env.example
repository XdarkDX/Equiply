# Kopieren nach .env und Werte anpassen. Die .env wird NICHT ins Git eingecheckt.

PORT=3000

# Pfad zur SQLite-Datenbankdatei (Ordner wird automatisch angelegt)
DB_PATH=./data/equiply.db

# Geheimer Schlüssel für Login-Tokens. Erzeugen z. B. mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

JWT_EXPIRES_IN=24h

# System-Owner (Superadmin). Leer lassen = Superadmin-Login deaktiviert.
SUPERADMIN_USER=
SUPERADMIN_PASSWORD=

# Nur nötig, wenn das Frontend von einer anderen Domain aufgerufen wird
# CORS_ORIGIN=https://equiply.example.de
