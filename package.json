{
  "name": "equiply",
  "version": "3.1.0",
  "description": "Equipment-Verwaltung für Vereine: Inventar, TÜV, Ausleihe, Fotos, Kommentare, Excel-Import",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "build:css": "tailwindcss -i styles/app.css -o public/app.css --minify",
    "watch:css": "tailwindcss -i styles/app.css -o public/app.css --watch",
    "package": "git archive --format=tar.gz --prefix=equiply/ -o equiply-$npm_package_version.tar.gz HEAD",
    "vendor": "node -e \"const v=require('jsqr/package.json').version;require('fs').writeFileSync('public/vendor/jsQR.js','/*! jsQR '+v+' | Apache-2.0 | https://github.com/cozmo/jsQR */\\n'+require('fs').readFileSync(require.resolve('jsqr/dist/jsQR.js')))\""
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "pngjs": "^5.0.0",
    "tailwindcss": "^3.4.19"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "private": true
}
